<div class="description-section">

  <div class="description-left-column">
    <!-- IMAGE -->
    <div class="portrait">
      <img class="profile-img" src="{{actor.img}}" data-edit="img">
    </div>

    <!-- JOURNAL -->
    <section class="journal-panel">
      <h3 class="journal-panel-title">Poznámky</h3>
      {{> "systems/shadowworld/templates/actor/tabs/tab-journal.hbs"}}
    </section>
  </div>

  <!-- RIGHT COLUMN -->
  <div class="basic-info">

    {{> "systems/shadowworld/templates/actor/parts/hp.hbs"}}

    {{#if ../isGM}}
      <div class="trait-select">
        <select name="system.trait">
          <option value="human">Human</option>
          <option value="vampire">Vampire</option>
          <option value="werewolf">Werewolf</option>
        </select>
      </div>
    {{/if}}

  </div>

</div>
